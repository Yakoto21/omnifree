{
  "name": "meu-conversor",
  "version": "1.0.10",
  "description": "Conversor local de arquivos OmniFree.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:manual": "npm run icon && electron-builder --win --publish never",
    "icon": "node scripts/create-icon.js",
    "test": "node --test"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@zxing/library": "^0.21.3",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-pandoc": "^0.3.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.omnifree.app",
    "productName": "OmniFree",
    "artifactName": "OmniFree-Setup-${version}.${ext}",
    "icon": "build/omnifree-icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "Yakoto21",
        "repo": "omnifree"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@29.4.6": true,
    "ffmpeg-static@5.3.0": true
  }
}
